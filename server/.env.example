# 后端监听端口
PORT=8787

# SQLite 和图片目录；相对路径按启动目录解析
DATA_DIR=./data

# 上游 API 根地址，不要包含 /anthropic/v1 或 /v1/tools
DEEPSEEK_API_ORIGIN=https://api.deepseek.com

# 必填：服务端持有的 API Key
DEEPSEEK_API_KEY=sk-replace-me

# 必填：生成方式 pnpm hash-password "your-password"
APP_PASSWORD_HASH=scrypt$16384$8$1$replace-with-base64-salt$replace-with-base64-hash

# 登录 Token 和 Cookie 的有效天数
TOKEN_TTL_DAYS=90

# 在线版的公开 origin；生产环境示例
# 本地 HTTP 开发可改为 http://localhost:8090，并把 COOKIE_SECURE 设为 0
APP_ORIGIN=https://chat.example.com:54321

# 允许跨源同步的本地版 origin，逗号分隔；必须包含协议、主机和端口
ALLOWED_SYNC_ORIGINS=http://localhost:8090

# 生产环境保持 1；只在本地 HTTP 调试时设为 0
COOKIE_SECURE=1

# 请求体大小上限（字节）
MAX_CHAT_BYTES=2097152
MAX_FILE_BYTES=26214400
MAX_ASR_BYTES=8388608

# 把域名、端口和 TLS 方式替换成自己的配置。
# 下面使用 dynv6 DNS-01 作为示例；不使用时删除 tls 块，
# 由 Caddy 自动申请证书，或改成自己的 DNS provider。
chat.example.com:54321 {
  tls {
    dns dynv6 {env.DYNV6_TOKEN}
  }

  # SSE 不能缓冲，否则回复会一次性出现
  handle /api/* {
    reverse_proxy 127.0.0.1:8787 {
      flush_interval -1
    }
  }

  # 替换为实际的 dist-online 目录
  handle {
    root * D:/WebChat/dist-online
    try_files {path} /index.html
    file_server
  }
}

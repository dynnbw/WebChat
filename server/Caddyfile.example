# Standard Caddy does not include a dynv6 DNS-01 solver.
# Obtain a certificate first, for example with acme.sh:
#   acme.sh --issue --server letsencrypt --dns dns_dynv6 -d chat.example.com
#   acme.sh --install-cert -d chat.example.com --fullchain-file /path/fullchain.pem \
#     --key-file /path/privkey.pem --reloadcmd "caddy reload --config ..."
# Then point tls at the installed files.
{
	auto_https off
}

https://chat.example.com:54321 {
	tls /path/to/fullchain.pem /path/to/privkey.pem

	handle /api/* {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}

	handle {
		root * D:/WebChat/dist-online
		try_files {path} /index.html
		file_server
	}

	@serviceWorker path /sw.js
	header @serviceWorker Cache-Control "no-cache"
}
